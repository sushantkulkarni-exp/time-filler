{
  "manifest_version": 3,
  "name": "Tempo to TalentFlow Smart Helper",
  "version": "3.0.0",
  "description": "Scrapes Jira Tempo and auto-fills TalentFlow timesheet with individual task entries per Tempo card.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.atlassian.net/*",
    "*://*.centralogic.ai/*",
    "*://*.talentflow.io/*",
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.atlassian.net/*",
        "*://*.tempo.io/*"
      ],
      "js": ["scripts/tempoCapture.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["scripts/tempoInject.js"],
      "matches": [
        "*://*.atlassian.net/*",
        "*://*.tempo.io/*"
      ]
    }
  ],
  "commands": {
    "capture_data": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "Capture Tempo Data"
    },
    "fill_data": {
      "suggested_key": {
        "default": "Alt+F",
        "mac": "Alt+F"
      },
      "description": "Auto-Fill TalentFlow Timesheet"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}